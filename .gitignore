# Local environment configuration (keep templates in version control)
.env
.env.*
!.env.example
!.env.*.example

# Python virtual environments and bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, linter and coverage output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Packaging and build output
*.egg-info/
*.egg
.eggs/
dist/
build/
pip-wheel-metadata/

# Agent sessions, traces and the default generated workspace
.xd-agent/
/workspace/

# Local backups
/.local-backups/

# Runtime logs
*.log
*.log.*

# Local editor state and temporary files
.idea/
*.code-workspace
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

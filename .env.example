# 仅在本地开发或测试时复制为 .env。
APP_ENV=development
APP_GREETING__PREFIX=Hello
# 默认 CLI。飞书模式需安装 feishu extra，并配置下列凭据。
APP_CHANNEL__TYPE=cli
APP_AGENT__API_KEY=
# 设为 false 时，所有命令均需人工审批；仍会提供命令分析说明。
APP_AGENT__AUTO_APPROVE_READ_ONLY_COMMANDS=true
# APP_AGENT__COMMAND_REVIEW_TIMEOUT_SECONDS=30
